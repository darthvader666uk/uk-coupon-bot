{
  "name": "uk-coupon-bot-scraper",
  "version": "1.0.0",
  "description": "Scrapes UK coupon codes from multiple sources",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "scrape": "node index.js",
    "scrape:ggdeals": "node index.js --source ggdeals",
    "scrape:savoo": "node index.js --source savoo",
    "scrape:coupert": "node index.js --source coupert",
    "test:userscript": "node scripts/test-userscript.mjs",
    "test:pipeline": "node scripts/test-pipeline.mjs",
    "test": "node scripts/test-pipeline.mjs && node scripts/test-userscript.mjs",
    "scrape:knoji": "node index.js --source=knoji"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.0",
    "playwright": "^1.61.1"
  }
}
